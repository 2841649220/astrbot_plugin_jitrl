{
  "enabled": {
    "description": "总开关",
    "type": "bool",
    "default": true,
    "hint": "关闭后插件不介入任何 LLM 请求，也不记录经验。"
  },
  "apply_mode": {
    "description": "策略应用方式",
    "type": "string",
    "default": "hint",
    "options": [
      "off",
      "hint",
      "logit"
    ],
    "labels": [
      "仅记录（不干预）",
      "偏好提示（V0.1）",
      "候选代理评分重排（V0.1）"
    ],
    "hint": "V0.1 的 hint 为经验提示；logit 使用 verbalized confidence 代理候选分数。均不修改远端模型内部 logits。off 也禁止 Neural Lens 注入。"
  },
  "learning": {
    "description": "学习回路（经验采集与奖励评估）",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用经验采集",
        "type": "bool",
        "default": true
      },
      "evaluator_mode": {
        "description": "步级奖励评估方式",
        "type": "string",
        "default": "auto",
        "options": [
          "auto",
          "llm",
          "heuristic",
          "off"
        ],
        "labels": [
          "自动",
          "LLM 评估器",
          "启发式规则",
          "关闭评分"
        ],
        "hint": "auto：有工具调用或长轨迹时用 LLM 评估器，否则用启发式；heuristic：只用规则，零额外开销。"
      },
      "evaluator_provider_id": {
        "description": "评估器使用的模型提供商",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "留空则复用当前会话正在使用的提供商。"
      },
      "evaluator_timeout": {
        "description": "评估器超时（秒）",
        "type": "float",
        "default": 30.0,
        "slider": {
          "min": 5,
          "max": 180,
          "step": 5
        }
      },
      "gamma": {
        "description": "折扣因子 γ",
        "type": "float",
        "default": 0.5,
        "slider": {
          "min": 0.05,
          "max": 0.99,
          "step": 0.05
        },
        "hint": "论文中 WebArena 用 0.1，Jericho 用 0.5。控制远期奖励权重。"
      },
      "heuristic_weight": {
        "description": "启发式信号权重",
        "type": "float",
        "default": 0.5,
        "slider": {
          "min": 0,
          "max": 1,
          "step": 0.1
        },
        "hint": "LLM 评分与规则评分融合时，规则评分所占比例。"
      },
      "min_steps": {
        "description": "最少记录步数",
        "type": "int",
        "default": 1,
        "slider": {
          "min": 1,
          "max": 10,
          "step": 1
        }
      },
      "async_learn": {
        "description": "后台异步学习",
        "type": "bool",
        "default": true,
        "hint": "开启后不阻塞回复发送。"
      },
      "success_detection": {
        "description": "任务成功判定",
        "type": "string",
        "default": "heuristic",
        "options": [
          "off",
          "heuristic"
        ],
        "labels": [
          "不判定",
          "启发式判定"
        ]
      }
    }
  },
  "retrieval": {
    "description": "记忆检索与价值估计",
    "type": "object",
    "items": {
      "k": {
        "description": "近邻数 k",
        "type": "int",
        "default": 10,
        "slider": {
          "min": 3,
          "max": 20,
          "step": 1
        },
        "hint": "论文实测 k∈[8,14] 最稳；过小方差大，过大噪声多。"
      },
      "similarity_threshold": {
        "description": "Jaccard 相似度阈值 r",
        "type": "float",
        "default": 0.8,
        "slider": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "hint": "论文 WebArena 用 0.8，Jericho 用 0.95。"
      },
      "surface_gate": {
        "description": "启用同域前置过滤",
        "type": "bool",
        "default": false,
        "hint": "开启后只在相同平台/领域的记忆里检索（对应论文的 Regularized URL 两层检索）。"
      },
      "scope_isolation": {
        "description": "记忆作用域",
        "type": "string",
        "default": "hybrid",
        "options": [
          "session",
          "global",
          "hybrid"
        ],
        "labels": [
          "仅当前会话",
          "全局共享",
          "混合（本会话优先，跨会话补充）"
        ]
      },
      "prefilter_limit": {
        "description": "检索批量上限",
        "type": "int",
        "default": 4000,
        "slider": {
          "min": 200,
          "max": 20000,
          "step": 100
        },
        "hint": "SQL 降级扫描的单批读取条数，同时兼容旧版的最大返回条数限制。候选不再按重叠词数或新旧截断，最终返回精确相似度最高的 min(k, 此值) 条；此值不再代表打分工作量或耗时的硬上限。"
      },
      "recency_half_life_days": {
        "description": "时效半衰期（天）",
        "type": "float",
        "default": 30.0,
        "slider": {
          "min": 1,
          "max": 365,
          "step": 1
        },
        "hint": "越久远的经验返回值按此衰减轻微下调。"
      },
      "min_count": {
        "description": "动作最少出现次数",
        "type": "int",
        "default": 1,
        "slider": {
          "min": 1,
          "max": 5,
          "step": 1
        },
        "hint": "低于该次数的动作不再直接丢弃，而是把它的回报向状态基线 V(s) 收缩（经验贝叶斯平滑）；1 表示不做平滑。"
      },
      "estimator_weighting": {
        "description": "价值估计加权方式",
        "type": "string",
        "default": "kernel",
        "options": [
          "kernel",
          "uniform"
        ],
        "labels": [
          "相似度核加权（推荐）",
          "论文等权平均"
        ],
        "hint": "kernel：按检索相似度×时效加权平均 G，低相似邻居权重更低，噪声更小；uniform：论文式 (4)(5) 的 1/|N| 等权平均。"
      }
    }
  },
  "policy": {
    "description": "策略更新（闭式解）",
    "type": "object",
    "items": {
      "beta": {
        "description": "温度 β",
        "type": "float",
        "default": 1.5,
        "slider": {
          "min": 0.1,
          "max": 10,
          "step": 0.1
        },
        "hint": "z' = z + β·Â 中控制策略偏离参考策略的强度。β 越大越激进。"
      },
      "exploration_rate": {
        "description": "探索率 λ",
        "type": "float",
        "default": 0.3,
        "slider": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "hint": "对无历史记录的动作给予乐观奖励的概率。论文 Jericho 0.65，WebArena 0.05。"
      },
      "ucb_alpha": {
        "description": "乐观奖励 α",
        "type": "float",
        "default": 5.0,
        "slider": {
          "min": 0.5,
          "max": 20,
          "step": 0.5
        },
        "hint": "未见动作的乐观价值 V(s)+α/|N(s)|，记忆越稀疏奖励越大。期望式下等价于优势 A=λ·α/|N(s)|。"
      },
      "exploration_estimate": {
        "description": "探索项计算方式",
        "type": "string",
        "default": "expected",
        "options": [
          "expected",
          "sample"
        ],
        "labels": [
          "期望式（稳定，推荐）",
          "论文伯努利采样"
        ],
        "hint": "expected：对论文的概率分支取闭式期望，中性基线取 Q=V（A=0），同一情景每次给出相同建议；sample：论文原式，按 λ 采样，同一情景的建议会在 +1 与 -1 之间跳动。"
      },
      "normalize_advantage": {
        "description": "优势归一化",
        "type": "bool",
        "default": true,
        "hint": "Ã = A / (max|A| + ε)，论文式 (25)。"
      },
      "sample_temperature": {
        "description": "重采样温度",
        "type": "float",
        "default": 1.0,
        "slider": {
          "min": 0.1,
          "max": 3,
          "step": 0.1
        }
      },
      "candidate_limit": {
        "description": "候选动作上限 |C|",
        "type": "int",
        "default": 3,
        "slider": {
          "min": 2,
          "max": 8,
          "step": 1
        },
        "hint": "论文使用 3 个候选动作。"
      },
      "tool_gate": {
        "description": "工具门控",
        "type": "bool",
        "default": false,
        "hint": "对高置信负优势的工具做屏蔽（等价于把它的 logit 压到 -∞）。"
      },
      "tool_gate_min_count": {
        "description": "门控最小样本数",
        "type": "int",
        "default": 3,
        "slider": {
          "min": 1,
          "max": 20,
          "step": 1
        }
      },
      "tool_gate_threshold": {
        "description": "门控负优势阈值",
        "type": "float",
        "default": -0.3,
        "slider": {
          "min": -1,
          "max": 0,
          "step": 0.05
        }
      },
      "max_hint_chars": {
        "description": "注入提示词的最大字数",
        "type": "int",
        "default": 900,
        "slider": {
          "min": 200,
          "max": 4000,
          "step": 100
        }
      }
    }
  },
  "memory": {
    "description": "记忆存储",
    "type": "object",
    "items": {
      "max_entries": {
        "description": "最大记忆条数",
        "type": "int",
        "default": 20000,
        "slider": {
          "min": 500,
          "max": 200000,
          "step": 500
        }
      },
      "redact_secrets": {
        "description": "脱敏存储",
        "type": "bool",
        "default": true,
        "hint": "写入前剔除邮箱、手机号、API Key、URL 中的凭据等敏感信息。"
      },
      "prune_strategy": {
        "description": "淘汰策略",
        "type": "string",
        "default": "low_value",
        "options": [
          "low_value",
          "oldest",
          "none"
        ],
        "labels": [
          "优先淘汰低价值",
          "优先淘汰最旧",
          "不淘汰"
        ]
      },
      "keep_episodes": {
        "description": "保留的剧集记录数",
        "type": "int",
        "default": 500,
        "slider": {
          "min": 50,
          "max": 5000,
          "step": 50
        }
      },
      "checkpoint_interval": {
        "description": "自动检查点间隔（Episode 数）",
        "type": "int",
        "default": 50,
        "slider": {
          "min": 0,
          "max": 10000,
          "step": 1
        },
        "hint": "首次使用时保存基线，之后每累计指定数量的 Episode 保存快照。0 关闭自动检查点，清空/回退前的安全备份仍保留。计数在插件重载后重新开始。"
      },
      "keep_checkpoints": {
        "description": "自动/安全检查点各自保留数量",
        "type": "int",
        "default": 20,
        "slider": {
          "min": 1,
          "max": 200,
          "step": 1
        },
        "hint": "自动检查点和操作前备份分别轮换。手动检查点不会自动删除，需要在面板或指令中主动删除。"
      }
    }
  },
  "feedback": {
    "description": "用户显式反馈",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用自然语言反馈识别",
        "type": "bool",
        "default": true,
        "hint": "用户回复\"对\"/\"不对\"等关键词时，回填为上一轮经验的强奖励信号。"
      },
      "positive_keywords": {
        "description": "正反馈关键词",
        "type": "list",
        "default": [
          "对",
          "正确",
          "没错",
          "谢谢",
          "好的",
          "太棒了",
          "有用",
          "helpful",
          "thanks",
          "correct",
          "great"
        ]
      },
      "negative_keywords": {
        "description": "负反馈关键词",
        "type": "list",
        "default": [
          "不对",
          "错了",
          "不是",
          "答非所问",
          "没用",
          "垃圾",
          "wrong",
          "incorrect",
          "useless",
          "no"
        ]
      },
      "window_seconds": {
        "description": "反馈回填时间窗（秒）",
        "type": "int",
        "default": 180,
        "slider": {
          "min": 30,
          "max": 1800,
          "step": 30
        }
      }
    }
  },
  "commands": {
    "description": "指令与面板",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用 /jitrl 指令组",
        "type": "bool",
        "default": true
      },
      "admin_only": {
        "description": "仅管理员可用",
        "type": "bool",
        "default": true
      },
      "enable_agent_tools": {
        "description": "向 Agent 暴露 jitrl_recall 工具",
        "type": "bool",
        "default": true
      }
    }
  },
  "debug": {
    "description": "调试",
    "type": "object",
    "items": {
      "log_decisions": {
        "description": "记录策略决策日志",
        "type": "bool",
        "default": false
      }
    }
  },
  "neural": {
    "description": "本地 Neural Lens（按平台实例隔离，默认 MiTA 主干）",
    "type": "object",
    "items": {
      "mode": {
        "description": "神经滤镜模式",
        "type": "string",
        "default": "off",
        "hint": "off 使用 V0.1 路径；shadow 采集私有快照但保持原始请求；active 在本地模型已训练且证据满足门控时注入提示。远端大模型始终冻结。",
        "options": [
          "off",
          "shadow",
          "active"
        ]
      },
      "pre_enabled": {
        "description": "允许请求前经验提示",
        "type": "bool",
        "default": true
      },
      "post_enabled": {
        "description": "启用独立 POST 候选评分 API",
        "type": "bool",
        "default": false,
        "hint": "现有 AstrBot 请求钩子尚未连接候选执行器；此设置仅控制显式调用 score_candidates 的适配器。"
      },
      "auto_train": {
        "description": "允许后台本地训练",
        "type": "bool",
        "default": false,
        "hint": "需显式安装 PyTorch；默认通过管理员 /jitrl lens train 训练。每个会话独立训练，绝不跨会话混用。"
      },
      "train_every": {
        "description": "后台训练间隔（执行事实数）",
        "type": "int",
        "default": 32
      },
      "min_samples": {
        "description": "最少已结算训练样本",
        "type": "int",
        "default": 32
      },
      "train_steps": {
        "description": "单次训练步数",
        "type": "int",
        "default": 20
      },
      "batch_size": {
        "description": "训练批大小",
        "type": "int",
        "default": 16
      },
      "learning_rate": {
        "description": "本地学习率",
        "type": "float",
        "default": 0.0003
      },
      "min_support": {
        "description": "最少不同历史回合支持",
        "type": "int",
        "default": 3,
        "hint": "按具有正相似度与可靠度权重的独立 episode 计数；同一回合重复调用不会增加支持度。PRE 证据还要求对应动作当前可用。"
      },
      "max_uncertainty": {
        "description": "残差不确定性代理阈值",
        "type": "float",
        "default": 0.5,
        "hint": "此数值未经概率校准，不是统计置信界。"
      },
      "relevance_threshold": {
        "description": "结构动作相关性代理阈值",
        "type": "float",
        "default": 0.6
      },
      "similarity_threshold": {
        "description": "冻结词法检索相似度阈值",
        "type": "float",
        "default": 0.25
      },
      "max_adjustment": {
        "description": "POST 代理评分最大调整幅度",
        "type": "float",
        "default": 1.0
      },
      "evidence_tokens": {
        "description": "提示预算目标",
        "type": "int",
        "default": 128,
        "hint": "当前使用不超过此数的 UTF-8 字节作为保守 token 预算代理；仅输出受控名称、历史回报、来源和证据 ID。"
      },
      "replay_limit": {
        "description": "回放及检索扫描上限",
        "type": "int",
        "default": 2048
      },
      "attention_backend": {
        "description": "神经注意力主干",
        "type": "string",
        "default": "mita",
        "options": [
          "mita",
          "hybrid",
          "gqa",
          "legacy"
        ],
        "hint": "默认四层全部使用 MiTA；hybrid 为 3 MiTA+1 GQA，gqa 是四层对照，legacy 保留开发早期的向量主干。更换主干需重新训练本地权重，经验与快照继续复用。"
      },
      "mita_landmarks": {
        "description": "每层 MiTA 的 landmark / expert 数",
        "type": "int",
        "default": 8
      },
      "mita_topk": {
        "description": "每个 expert 的原始 KV 上限",
        "type": "int",
        "default": 16
      },
      "mita_query_chunk": {
        "description": "MiTA query / expert 分块上限",
        "type": "int",
        "default": 64,
        "hint": "分组执行在短序列使用不超过 32 的块降低 padding；参考路径使用该 query 分块上限。"
      },
      "memory_tokens": {
        "description": "进入神经 token 主干的历史经验上限",
        "type": "int",
        "default": 128
      },
      "device": {
        "description": "本地神经训练与推理设备",
        "type": "string",
        "default": "cpu",
        "options": [
          "cpu",
          "cuda",
          "auto"
        ],
        "hint": "默认 CPU；cuda 明确要求可用 GPU，auto 自动选择。权重可跨设备加载；修改后重载插件。"
      },
      "mita_execution": {
        "description": "MiTA 执行内核",
        "type": "string",
        "default": "grouped",
        "options": [
          "grouped",
          "reference"
        ],
        "hint": "grouped 按 expert 复用 KV 并使用融合 SDPA；reference 保留逐 query 对照。公式与参数相同，切换无需重训。"
      }
    }
  }
}
