# Normalise every text file to LF in the repository so Windows checkouts and
# the Linux CI runner produce identical blobs and diffs.
* text=auto eol=lf

# Keep Git archives and release ZIPs focused on the installable plugin.
/.github export-ignore
/tests export-ignore
/scripts export-ignore
/pyproject.toml export-ignore
/.gitignore export-ignore
/.gitattributes export-ignore
/AGENTS.md export-ignore
/dist export-ignore
# Development-only documentation (compliance and host-API audits); the release
# payload is unchanged, but a GitHub source-archive install should not have to
# carry it.
/docs export-ignore
/benchmarks export-ignore
